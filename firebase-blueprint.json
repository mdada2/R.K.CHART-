{
  "entities": {
    "Admin": {
      "title": "Admin Marker",
      "description": "Trusted administrator UID marker document",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Verified administrator email"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      },
      "required": ["email", "createdAt"]
    },
    "User": {
      "title": "User Profile",
      "description": "Authenticated user profile and study preferences",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified Google account email"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "User display name"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "User profile photo URL"
        },
        "preferredLanguage": {
          "type": "string",
          "enum": ["mr", "en"],
          "maxLength": 5,
          "description": "Preferred UI language"
        },
        "preferredMarket": {
          "type": "string",
          "enum": ["kalyan", "rajdhani_night"],
          "maxLength": 20,
          "description": "Preferred default market"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update"
        }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "PassbookEntry": {
      "title": "Personal Guessing Passbook Entry",
      "description": "User's saved daily OTC, Jodi, and Pana study entry for pass/fail tracking",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique entry identifier"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID"
        },
        "market": {
          "type": "string",
          "enum": ["kalyan", "rajdhani_night"],
          "maxLength": 20,
          "description": "Target market identifier"
        },
        "week": {
          "type": "string",
          "minLength": 5,
          "maxLength": 40,
          "description": "Week range string (e.g. 26-10-26 to 01-11-26)"
        },
        "day": {
          "type": "string",
          "enum": ["mon", "tue", "wed", "thu", "fri", "sat"],
          "maxLength": 5,
          "description": "Target weekday key"
        },
        "otcDigits": {
          "type": "array",
          "description": "Bounded list of 1 to 4 integer OTC digits (0-9)"
        },
        "jodis": {
          "type": "array",
          "description": "Bounded list of up to 8 2-digit Jodi strings"
        },
        "panas": {
          "type": "array",
          "description": "Bounded list of up to 6 3-digit Pana strings"
        },
        "note": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional study trick note"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when entry was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when entry was last updated"
        }
      },
      "required": ["id", "userId", "market", "week", "day", "otcDigits", "jodis", "panas", "note", "createdAt", "updatedAt"]
    },
    "ChartWeek": {
      "title": "Chart Data Week",
      "description": "Historical and live weekly chart record partitioned per week",
      "type": "object",
      "properties": {
        "market": {
          "type": "string",
          "enum": ["kalyan", "rajdhani_night"],
          "maxLength": 20,
          "description": "Market identifier"
        },
        "week": {
          "type": "string",
          "minLength": 5,
          "maxLength": 40,
          "description": "Week date range label"
        },
        "weekIndex": {
          "type": "number",
          "description": "Chronological ordering index"
        },
        "mon": { "type": "object", "description": "Monday openPana, jodi, closePana" },
        "tue": { "type": "object", "description": "Tuesday openPana, jodi, closePana" },
        "wed": { "type": "object", "description": "Wednesday openPana, jodi, closePana" },
        "thu": { "type": "object", "description": "Thursday openPana, jodi, closePana" },
        "fri": { "type": "object", "description": "Friday openPana, jodi, closePana" },
        "sat": { "type": "object", "description": "Saturday openPana, jodi, closePana" },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of update"
        }
      },
      "required": ["market", "week", "weekIndex", "mon", "tue", "wed", "thu", "fri", "sat", "updatedAt"]
    }
  },
  "firestore": {
    "admins/{adminId}": {
      "schema": "Admin",
      "description": "Trusted administrator lookup collection"
    },
    "users/{userId}": {
      "schema": "User",
      "description": "Private user profiles isolated per owner"
    },
    "users/{userId}/passbook/{entryId}": {
      "schema": "PassbookEntry",
      "description": "Private daily guessing passbook entries per user"
    },
    "charts/{marketId}/weeklyData/{weekId}": {
      "schema": "ChartWeek",
      "description": "Publicly readable, admin-writable weekly chart documents"
    }
  }
}
